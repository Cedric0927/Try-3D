[
  ["click", "#auto"],
  ["until", "sorterState().phase==='transfer'", 20000],
  ["eval", "if(sorterState().lift!==8||!sorterState().scanned||sorterState().parcel.z!==92.3)throw Error('transfer interlock failed'); 'lift before transfer passed'"],
  ["click", "#play"],
  ["eval", "window.savedParcel=JSON.stringify(sorterState().parcel);window.savedLift=sorterState().lift; 'paused'"],
  ["wait", 500],
  ["eval", "if(JSON.stringify(sorterState().parcel)!==savedParcel)throw Error('pause did not freeze'); 'pause passed'"],
  ["shot", "shots/sorter-transfer.png", ".app"],
  ["click", "#explode"],
  ["wait", 2200],
  ["eval", "if(sorterState().running||sorterState().lift!==savedLift)throw Error('service interlock failed'); 'service stops without losing stroke'"],
  ["shot", "shots/sorter-exploded.png", ".app"],
  ["click", "[data-part='cassette']"],
  ["shot", "shots/sorter-cassette.png", ".figure"],
  ["click", "[data-part='cassette']"],
  ["click", "#play"],
  ["until", "sorterState().assembled&&sorterState().running", 7000],
  ["until", "sorterState().accepted===1", 10000],
  ["eval", "if(sorterState().accepted!==1)throw Error('side delivery failed'); 'resumed side delivery passed'"],
  ["until", "sorterState().phase==='idle'", 4000],
  ["eval", "document.getElementById('mass').value=20;document.getElementById('mass').dispatchEvent(new Event('input')); 'mass set to 20 kg'"],
  ["click", "#add"],
  ["until", "sorterState().disposition==='review'", 10000],
  ["eval", "if(sorterState().lift!==0)throw Error('overweight must not lift'); 'overweight interlock passed'"],
  ["shot", "shots/sorter-overweight.png", ".app"],
  ["until", "sorterState().review===1", 10000],
  ["click", "#play"],
  ["click", "#theme"],
  ["shot", "shots/sorter-dark.png", ".app"],
  ["eval", "if(sorterState().created!==sorterState().completed+sorterState().queue+(sorterState().parcel?1:0))throw Error('parcel conservation failed'); 'browser flow passed'"]
]
